# ============================================================================
# SignFlow configuration. Copy to .env and fill in. Never commit .env to git.
# ============================================================================

# --- Your domain (used by Caddy for HTTPS and by the app for links in emails) ---
DOMAIN=sign.example.com
ACME_EMAIL=you@example.com
APP_URL=https://sign.example.com
# Must be 1 in production (HTTPS): marks the session cookie Secure and turns on HSTS.
COOKIE_SECURE=1

# --- Private platform: keep SignFlow for your own organisation only ---
# PRIVATE_MODE=1 hides the public website and pricing, disables self sign-up (invite only) and asks search
# engines not to index the site. Values set here override Platform > Private access and can't be changed
# from the browser. Leave empty to manage them in the app instead.
PRIVATE_MODE=
# Only these email domains may have accounts, e.g. yourcompany.com,yourgroup.in
ALLOWED_EMAIL_DOMAINS=
# Only these IPs/ranges can reach the app (signing links stay open), e.g. 203.0.113.0/24
PLATFORM_IP_ALLOWLIST=

# --- Encryption key for documents at rest (REQUIRED in production) ---
# Generate once with:  openssl rand -base64 32
# Store a copy in your password manager. Without it, backups cannot be decrypted.
MASTER_KEY=

# --- Email (can also be set later in Settings > Email delivery) ---
# Amazon SES (Mumbai): SMTP_HOST=email-smtp.ap-south-1.amazonaws.com  SMTP_PORT=587
# Zoho Mail:           SMTP_HOST=smtp.zoho.in                           SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SignFlow <no-reply@example.com>"

# --- Document seal certificate (optional) ---
# A CA-issued document-signing certificate (PKCS#12) makes Adobe show the seal as trusted.
# If unset, a self-signed seal is generated: still tamper-evident, but readers show "issuer unknown".
# Put the .p12 file in the data volume (e.g. /data/keys/seal-ca.p12) and point to it here.
SEAL_P12_PATH=
SEAL_P12_PASSWORD=

# --- Reverse proxy: how many proxies sit in front of the app (Caddy = 1) ---
TRUST_PROXY=1

# --- Backups (scripts/backup.js) ---
BACKUP_KEEP_DAYS=14

# Label shown in Security settings for where data is stored (e.g. "AWS ap-south-1 (Mumbai)")
DATA_REGION=

# Port the app listens on inside the container / on the host when run without Docker
PORT=3000
# Data directory when run without Docker
# DATA_DIR=/var/lib/signflow
