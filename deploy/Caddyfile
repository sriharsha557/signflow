# HTTPS certificates are issued and renewed automatically by Let's Encrypt / ZeroSSL.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 30MB
	}
	reverse_proxy signflow:3000 {
		header_up X-Forwarded-Proto {scheme}
	}
}

# Redirect www to the main domain (remove if you don't use www).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
